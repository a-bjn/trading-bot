# Solana Trading Bot Configuration
# Copy this file to .env and fill in your values

# === WALLET CONFIGURATION ===
# Your wallet private key (base58 encoded)
# CRITICAL: Keep this secret! Never commit to git!
WALLET_PRIVATE_KEY=your_base58_private_key_here

# Alternative: Path to keypair JSON file
# WALLET_KEYFILE=/path/to/keypair.json

# === RPC CONFIGURATION ===
# Solana RPC endpoint (use a premium RPC for best performance)
RPC_URL=https://api.mainnet-beta.solana.com
WS_URL=wss://api.mainnet-beta.solana.com

# Optional: Helius API key for enhanced transaction data
# Get one at: https://helius.dev
# HELIUS_API_KEY=your_helius_api_key

# Optional: QuickNode or other premium RPC
# RPC_URL=https://your-quicknode-endpoint.solana-mainnet.quiknode.pro/
# WS_URL=wss://your-quicknode-endpoint.solana-mainnet.quiknode.pro/

# === TELEGRAM NOTIFICATIONS (Optional) ===
# Create a bot with @BotFather on Telegram
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# === JITO CONFIGURATION (Optional - for MEV protection) ===
# JITO_BLOCK_ENGINE_URL=https://ny.mainnet.block-engine.jito.wtf
# JITO_TIP_LAMPORTS=5000

# === RUNTIME OPTIONS ===
# Set to true to run in simulation mode (no real trades)
DRY_RUN=false

# Log level (trace, debug, info, warn, error)
RUST_LOG=info

# === NOTES ===
# 1. All trading configuration is in config/bot_config.yaml
# 2. This .env file is for secrets and runtime overrides only
# 3. Never commit .env to git (it's in .gitignore)
# 4. Start with DRY_RUN=true to test without real trades
